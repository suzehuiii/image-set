# Copy to a secret-managed location outside the repository. Never commit real values.
APP_DOMAIN=studio.example.com
APP_IMAGE=image-set-app:production
TLS_CERT_DIR=/opt/image-set/secrets/tls
HTTP_PORT=80
HTTPS_PORT=443
NPM_REGISTRY=https://registry.npmjs.org

DATABASE_URL=postgresql://image_set:replace-me@db.example.internal:5432/image_set?sslmode=require
REDIS_URL=rediss://:replace-me@redis.example.internal:6379

S3_ENDPOINT=https://s3.example.com
S3_PUBLIC_ENDPOINT=https://assets.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET=image-set-production
S3_FORCE_PATH_STYLE=false

OPENAI_API_KEY=replace-me
OPENAI_ANALYSIS_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_REVIEW_MODEL=gpt-6-luna

# Per-IP application limits. Nginx also applies a broad 10 requests/second limit.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_ANALYSIS_MAX=10
RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=3600
RATE_LIMIT_GENERATION_MAX=30
RATE_LIMIT_GENERATION_WINDOW_SECONDS=3600
