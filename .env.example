# Application
NODE_ENV=development
DEPLOYMENT_ENV=local
NPM_REGISTRY=https://registry.npmmirror.com
WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
API_INTERNAL_URL=http://api:3001/api
WEB_ORIGIN=http://localhost:3000,http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# Sensitive API per-IP limits
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_ANALYSIS_MAX=10
RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=3600
RATE_LIMIT_GENERATION_MAX=30
RATE_LIMIT_GENERATION_WINDOW_SECONDS=3600

# PostgreSQL
POSTGRES_DB=image_set
POSTGRES_USER=image_set
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql://image_set:change-me-for-non-local-use@postgres:5432/image_set

# Redis / BullMQ
REDIS_URL=redis://redis:6379

# S3-compatible storage / MinIO
MINIO_ROOT_USER=image_set
MINIO_ROOT_PASSWORD=change-me-for-non-local-use
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=image_set
S3_SECRET_KEY=change-me-for-non-local-use
S3_BUCKET=image-set-local
S3_FORCE_PATH_STYLE=true

# AI model configuration (server-side only; never commit a real key)
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_REVIEW_MODEL=gpt-6-luna
